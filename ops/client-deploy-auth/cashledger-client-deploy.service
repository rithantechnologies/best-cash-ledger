[Unit]
Description=Authorized Cash Ledger client release activation only
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/cashledger-client-deploy
TimeoutStartSec=300
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
