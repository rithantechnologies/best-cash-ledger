// ONLY cashdeploy may START the dedicated Cash Ledger deployment service.
// No permission to edit services, stop/restart, or manage other applications.
polkit.addRule(function(action, subject) {
  if (action.id === "org.freedesktop.systemd1.manage-units" &&
      subject.user === "cashdeploy" &&
      action.lookup("unit") === "cashledger-client-deploy.service" &&
      action.lookup("verb") === "start") {
    return polkit.Result.YES;
  }
});
