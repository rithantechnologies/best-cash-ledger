generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  OWNER
  ADMIN
  STAFF
}

enum CustomerType {
  WALK_IN
  REGULAR
}

enum AccountType {
  CASH
  BANK
  UPI
  PROVIDER_WALLET
  OWNER_CREDIT_CARD
}

enum AccountNature {
  ASSET
  LIABILITY
}

enum UsageType {
  BUSINESS
  PERSONAL
  MIXED
}

enum TransactionType {
  CARD_SWIPE
  CASH_TRANSFER
  SERVICE_INCOME
  AEPS_WITHDRAWAL
  MICRO_ATM
  CUSTOMER_PAYOUT
  CUSTOMER_RECEIVABLE
  CUSTOMER_RECEIPT
  PROVIDER_SETTLEMENT
  INTERNAL_TRANSFER
  BUSINESS_EXPENSE
  PERSONAL_EXPENSE
  ATM_WITHDRAWAL
  OWNER_CC_PAYMENT
  CARD_DUE_CLEARING
  CARD_DUE_RECOVERY
  CARD_DUE_COMMISSION_COLLECTION
  CASH_ADJUSTMENT
  REVERSAL
}

enum TransactionStatus {
  PENDING
  COMPLETED
  PARTIALLY_PAID
  PAID
  OVERDUE
  FAILED
  CANCELLED
  REVERSED
}

enum CalculationType {
  PERCENTAGE
  FIXED
}

enum PayableStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REVERSED
}

enum ReceivableStatus {
  PENDING
  PARTIALLY_RECEIVED
  RECEIVED
  OVERDUE
  CANCELLED
  REVERSED
}

enum PaymentStatus {
  COMPLETED
  REVERSED
}

enum ProviderSettlementStatus {
  PENDING
  PARTIALLY_SETTLED
  SETTLED
  CANCELLED
  REVERSED
}

enum ReceivableReasonCategory {
  ADVANCE
  SETTLEMENT_DUE
  SHORTAGE_RECOVERY
  LOAN
  ADJUSTMENT
  OTHER
}

enum CommissionMethod {
  ADD_ON
  DEDUCT
}

enum LedgerType {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
  EQUITY
}

enum EntryType {
  DEBIT
  CREDIT
}

enum JournalStatus {
  POSTED
  REVERSED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CountType {
  OPENING
  CLOSING
}

model Role {
  id        String   @id @default(uuid())
  name      RoleName @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String     @id @default(uuid())
  fullName     String
  mobile       String?    @unique
  email        String?    @unique
  passwordHash String
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  customers    Customer[]
}

model Customer {
  id            String                @id @default(uuid())
  customerCode  String                @unique
  customerType  CustomerType
  fullName      String
  mobile        String?
  notes         String?
  isActive      Boolean               @default(true)
  createdById   String
  createdBy     User                  @relation(fields: [createdById], references: [id])
  cards         CustomerCard[]
  bankAccounts  CustomerBankAccount[]
  upiAccounts   CustomerUpiAccount[]
  beneficiaries Beneficiary[]
  transactions  Transaction[]
  payables      CustomerPayable[]
  receivables   CustomerReceivable[]
  ledgerEntries LedgerEntry[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([fullName])
  @@index([mobile])
}

model CustomerCard {
  id               String                  @id @default(uuid())
  customerId       String
  customer         Customer                @relation(fields: [customerId], references: [id])
  bankName         String
  cardType         String?
  lastFourDigits   String
  nickname         String?
  isActive         Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  cardSwipeDetails CardSwipeDetail[]
  cardDueClearings CardDueClearingDetail[]
}

model CustomerBankAccount {
  id                String               @id @default(uuid())
  customerId        String
  customer          Customer             @relation(fields: [customerId], references: [id])
  accountHolderName String
  bankName          String
  accountReference  String
  ifsc              String?
  isActive          Boolean              @default(true)
  cashTransfers     CashTransferDetail[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model CustomerUpiAccount {
  id            String               @id @default(uuid())
  customerId    String
  customer      Customer             @relation(fields: [customerId], references: [id])
  accountName   String
  upiId         String?
  mobileNumber  String?
  providerName  String?
  isActive      Boolean              @default(true)
  cashTransfers CashTransferDetail[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model Beneficiary {
  id               String               @id @default(uuid())
  customerId       String
  customer         Customer             @relation(fields: [customerId], references: [id])
  beneficiaryName  String
  relationshipNote String?
  notes            String?
  isActive         Boolean              @default(true)
  accounts         BeneficiaryAccount[]
  cashTransfers    CashTransferDetail[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model BeneficiaryAccount {
  id               String               @id @default(uuid())
  beneficiaryId    String
  beneficiary      Beneficiary          @relation(fields: [beneficiaryId], references: [id])
  accountType      String
  bankName         String?
  accountReference String?
  ifsc             String?
  upiId            String?
  mobileNumber     String?
  isActive         Boolean              @default(true)
  cashTransfers    CashTransferDetail[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model Provider {
  id                 String               @id @default(uuid())
  name               String               @unique
  providerType       String
  notes              String?
  supportsAeps       Boolean              @default(false)
  aepsCommissionRate Decimal              @default(0) @db.Decimal(10, 4)
  isActive           Boolean              @default(true)
  gateways           ProviderGateway[]
  accounts           FinancialAccount[]
  charges            TransactionCharge[]
  settlements        ProviderSettlement[]
  cardDueRecoveries  CardDueRecovery[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model ProviderGateway {
  id                String               @id @default(uuid())
  providerId        String
  provider          Provider             @relation(fields: [providerId], references: [id])
  gatewayName       String
  gatewayCode       String?
  defaultChargeType CalculationType
  defaultChargeRate Decimal              @db.Decimal(10, 4)
  isActive          Boolean              @default(true)
  settlements       ProviderSettlement[]
  cardDueRecoveries CardDueRecovery[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([providerId, gatewayName])
}

model PaymentTerm {
  id                    String            @id @default(uuid())
  name                  String            @unique
  durationValue         Int
  durationUnit          String
  defaultCommissionType CalculationType
  defaultCommissionRate Decimal           @db.Decimal(10, 4)
  isActive              Boolean           @default(true)
  commissionRules       CommissionRule[]
  cardSwipes            CardSwipeDetail[]
  payables              CustomerPayable[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

model CommissionRule {
  id              String          @id @default(uuid())
  customerId      String?
  providerId      String?
  gatewayId       String?
  paymentTermId   String?
  transactionType TransactionType
  commissionType  CalculationType
  commissionRate  Decimal         @db.Decimal(10, 4)
  isActive        Boolean         @default(true)
  paymentTerm     PaymentTerm?    @relation(fields: [paymentTermId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([customerId, providerId, gatewayId, paymentTermId])
}

model FinancialAccount {
  id                             String                        @id @default(uuid())
  accountCode                    String                        @unique
  accountName                    String
  accountType                    AccountType
  accountNature                  AccountNature
  providerId                     String?
  provider                       Provider?                     @relation(fields: [providerId], references: [id])
  bankName                       String?
  accountReference               String?
  lastFourDigits                 String?
  creditLimit                    Decimal?                      @db.Decimal(18, 2)
  usageType                      UsageType
  openingBalance                 Decimal                       @default(0) @db.Decimal(18, 2)
  isActive                       Boolean                       @default(true)
  ledgerAccount                  LedgerAccount?
  dailyBalances                  DailyAccountBalance[]
  cardSwipeSettlements           CardSwipeDetail[]
  payablePayments                PayablePayment[]
  receivableSources              CustomerReceivable[]          @relation("ReceivableSourceAccount")
  receivableCollections          ReceivableCollection[]        @relation("ReceivableCollectionAccount")
  cashTransfersOut               CashTransferDetail[]          @relation("CashTransferSource")
  cashTransfersCash              CashTransferDetail[]          @relation("CashTransferCash")
  quickCashMovements             QuickCashTransferDetail[]     @relation("QuickCashMovementCash")
  quickCashSources               QuickCashTransferDetail[]     @relation("QuickCashMovementSource")
  quickCashCommissionAccounts    QuickCashTransferDetail[]     @relation("QuickCashCommissionAccount")
  aepsSettlements                AepsDetail[]                  @relation("AepsSettlement")
  aepsCash                       AepsDetail[]                  @relation("AepsCash")
  microAtmSettlements            MicroAtmDetail[]              @relation("MicroAtmSettlement")
  microAtmCash                   MicroAtmDetail[]              @relation("MicroAtmCash")
  internalTransfersOut           InternalTransferDetail[]      @relation("InternalTransferSource")
  internalTransfersIn            InternalTransferDetail[]      @relation("InternalTransferDestination")
  expensePayments                ExpenseDetail[]
  atmWithdrawalsFromBank         AtmWithdrawalDetail[]         @relation("AtmBankAccount")
  atmWithdrawalsToCash           AtmWithdrawalDetail[]         @relation("AtmCashAccount")
  creditCardPaymentsAsCard       CreditCardPaymentDetail[]     @relation("CreditCardPaymentCard")
  creditCardPaymentsAsSource     CreditCardPaymentDetail[]     @relation("CreditCardPaymentSource")
  cardDueAdvanceSources          CardDueClearingDetail[]       @relation("CardDueAdvanceSource")
  cardDueRecoveryDestinations    CardDueRecovery[]             @relation("CardDueRecoveryDestination")
  cardDueCommissionDestinations  CardDueCommissionCollection[] @relation("CardDueCommissionDestination")
  cashSessions                   CashSession[]
  providerSettlementDestinations ProviderSettlement[]          @relation("ProviderSettlementDestination")
  providerSettlementReceipts     ProviderSettlementReceipt[]   @relation("ProviderSettlementReceiptAccount")
  createdAt                      DateTime                      @default(now())
  updatedAt                      DateTime                      @updatedAt

  @@unique([providerId, accountType])
}

model ExpenseCategory {
  id           String          @id @default(uuid())
  name         String          @unique
  expenseUsage UsageType
  isActive     Boolean         @default(true)
  expenses     ExpenseDetail[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Transaction {
  id                          String                       @id @default(uuid())
  transactionNumber           String                       @unique
  transactionType             TransactionType
  transactionAt               DateTime
  customerId                  String?
  customer                    Customer?                    @relation(fields: [customerId], references: [id])
  grossAmount                 Decimal                      @db.Decimal(18, 2)
  netAmount                   Decimal?                     @db.Decimal(18, 2)
  status                      TransactionStatus
  referenceNumber             String?
  notes                       String?
  idempotencyKey              String?                      @unique
  reversedTransactionId       String?
  reversalReason              String?
  createdById                 String
  updatedById                 String?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  charges                     TransactionCharge[]
  commissions                 TransactionCommission[]
  cardSwipe                   CardSwipeDetail?
  cashTransfer                CashTransferDetail?
  quickCashTransfer           QuickCashTransferDetail?
  aeps                        AepsDetail?
  microAtm                    MicroAtmDetail?
  internalTransfer            InternalTransferDetail?
  expense                     ExpenseDetail?
  atmWithdrawal               AtmWithdrawalDetail?
  creditCardPayment           CreditCardPaymentDetail?
  cardDueClearing             CardDueClearingDetail?
  cardDueRecovery             CardDueRecovery?
  cardDueCommissionCollection CardDueCommissionCollection?
  payable                     CustomerPayable?
  payablePayment              PayablePayment?
  receivableSource            CustomerReceivable?          @relation("ReceivableSourceTransaction")
  receivableCollection        ReceivableCollection?        @relation("ReceivableCollectionTransaction")
  providerSettlementSource    ProviderSettlement?          @relation("ProviderSettlementSourceTransaction")
  providerSettlementReceipt   ProviderSettlementReceipt?   @relation("ProviderSettlementReceiptTransaction")
  cashAdjustmentSession       CashSession?                 @relation("CashSessionAdjustment")
  journal                     LedgerJournal?

  @@index([transactionAt])
  @@index([transactionType, transactionAt])
  @@index([customerId, transactionAt])
  @@index([status])
}

model TransactionCharge {
  id              String          @id @default(uuid())
  transactionId   String
  transaction     Transaction     @relation(fields: [transactionId], references: [id])
  chargeType      String
  providerId      String?
  provider        Provider?       @relation(fields: [providerId], references: [id])
  gatewayId       String?
  calculationType CalculationType
  rate            Decimal?        @db.Decimal(10, 4)
  amount          Decimal         @db.Decimal(18, 2)
  notes           String?
  createdAt       DateTime        @default(now())

  @@index([transactionId])
  @@index([providerId])
}

model TransactionCommission {
  id              String          @id @default(uuid())
  transactionId   String
  transaction     Transaction     @relation(fields: [transactionId], references: [id])
  commissionType  String
  calculationType CalculationType
  rate            Decimal         @db.Decimal(10, 4)
  amount          Decimal         @db.Decimal(18, 2)
  createdAt       DateTime        @default(now())

  @@index([transactionId])
}

model CardSwipeDetail {
  id                    String           @id @default(uuid())
  transactionId         String           @unique
  transaction           Transaction      @relation(fields: [transactionId], references: [id])
  customerCardId        String
  customerCard          CustomerCard     @relation(fields: [customerCardId], references: [id])
  swipeAmount           Decimal          @db.Decimal(18, 2)
  providerId            String
  gatewayId             String
  providerChargeRate    Decimal          @db.Decimal(10, 4)
  providerChargeAmount  Decimal          @db.Decimal(18, 2)
  commissionRate        Decimal          @db.Decimal(10, 4)
  commissionAmount      Decimal          @db.Decimal(18, 2)
  customerPayableAmount Decimal          @db.Decimal(18, 2)
  paymentTermId         String
  paymentTerm           PaymentTerm      @relation(fields: [paymentTermId], references: [id])
  dueAt                 DateTime
  settlementAccountId   String
  settlementAccount     FinancialAccount @relation(fields: [settlementAccountId], references: [id])
  settlementAmount      Decimal          @db.Decimal(18, 2)
  createdAt             DateTime         @default(now())

  @@index([providerId, gatewayId])
  @@index([dueAt])
}

model CardDueClearingDetail {
  id                     String                        @id @default(uuid())
  transactionId          String                        @unique
  transaction            Transaction                   @relation(fields: [transactionId], references: [id])
  customerCardId         String
  customerCard           CustomerCard                  @relation(fields: [customerCardId], references: [id])
  advanceSourceAccountId String
  advanceSourceAccount   FinancialAccount              @relation("CardDueAdvanceSource", fields: [advanceSourceAccountId], references: [id])
  dueAmount              Decimal                       @db.Decimal(18, 2)
  commissionRate         Decimal                       @db.Decimal(10, 4)
  commissionAmount       Decimal                       @db.Decimal(18, 2)
  principalRecovered     Decimal                       @default(0) @db.Decimal(18, 2)
  principalRemaining     Decimal                       @db.Decimal(18, 2)
  commissionCollected    Decimal                       @default(0) @db.Decimal(18, 2)
  commissionRemaining    Decimal                       @db.Decimal(18, 2)
  nextFollowUpAt         DateTime?
  duePaymentReference    String?
  recoveries             CardDueRecovery[]
  commissionCollections  CardDueCommissionCollection[]
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt

  @@index([nextFollowUpAt])
  @@index([principalRemaining])
  @@index([commissionRemaining])
}

model CardDueRecovery {
  id                   String                @id @default(uuid())
  clearingId           String
  clearing             CardDueClearingDetail @relation(fields: [clearingId], references: [id])
  transactionId        String                @unique
  transaction          Transaction           @relation(fields: [transactionId], references: [id])
  swipeAmount          Decimal               @db.Decimal(18, 2)
  providerId           String
  provider             Provider              @relation(fields: [providerId], references: [id])
  gatewayId            String
  gateway              ProviderGateway       @relation(fields: [gatewayId], references: [id])
  providerChargeRate   Decimal               @db.Decimal(10, 4)
  providerChargeAmount Decimal               @db.Decimal(18, 2)
  destinationAccountId String
  destinationAccount   FinancialAccount      @relation("CardDueRecoveryDestination", fields: [destinationAccountId], references: [id])
  referenceNumber      String?
  notes                String?
  recoveredAt          DateTime
  createdById          String
  createdAt            DateTime              @default(now())

  @@index([clearingId, recoveredAt])
  @@index([destinationAccountId])
}

model CardDueCommissionCollection {
  id                   String                @id @default(uuid())
  clearingId           String
  clearing             CardDueClearingDetail @relation(fields: [clearingId], references: [id])
  transactionId        String                @unique
  transaction          Transaction           @relation(fields: [transactionId], references: [id])
  amount               Decimal               @db.Decimal(18, 2)
  paymentMode          String
  destinationAccountId String
  destinationAccount   FinancialAccount      @relation("CardDueCommissionDestination", fields: [destinationAccountId], references: [id])
  referenceNumber      String?
  notes                String?
  collectedAt          DateTime
  createdById          String
  createdAt            DateTime              @default(now())

  @@index([clearingId, collectedAt])
  @@index([destinationAccountId])
}

model CustomerPayable {
  id                  String           @id @default(uuid())
  customerId          String
  customer            Customer         @relation(fields: [customerId], references: [id])
  sourceTransactionId String           @unique
  sourceTransaction   Transaction      @relation(fields: [sourceTransactionId], references: [id])
  paymentTermId       String?
  paymentTerm         PaymentTerm?     @relation(fields: [paymentTermId], references: [id])
  originalAmount      Decimal          @db.Decimal(18, 2)
  paidAmount          Decimal          @default(0) @db.Decimal(18, 2)
  remainingAmount     Decimal          @db.Decimal(18, 2)
  dueAt               DateTime
  status              PayableStatus
  payments            PayablePayment[]
  ledgerEntries       LedgerEntry[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([customerId])
  @@index([status, dueAt])
}

model PayablePayment {
  id                   String           @id @default(uuid())
  payableId            String
  payable              CustomerPayable  @relation(fields: [payableId], references: [id])
  transactionId        String           @unique
  transaction          Transaction      @relation(fields: [transactionId], references: [id])
  paymentDate          DateTime
  sourceAccountId      String
  sourceAccount        FinancialAccount @relation(fields: [sourceAccountId], references: [id])
  amount               Decimal          @db.Decimal(18, 2)
  destinationType      String?
  destinationLabel     String?
  destinationReference String?
  destinationDetails   Json?
  referenceNumber      String?
  notes                String?
  status               PaymentStatus
  createdById          String
  createdAt            DateTime         @default(now())

  @@index([payableId])
}

model CustomerReceivable {
  id                  String                   @id @default(uuid())
  customerId          String
  customer            Customer                 @relation(fields: [customerId], references: [id])
  sourceTransactionId String                   @unique
  sourceTransaction   Transaction              @relation("ReceivableSourceTransaction", fields: [sourceTransactionId], references: [id])
  sourceAccountId     String?
  sourceAccount       FinancialAccount?        @relation("ReceivableSourceAccount", fields: [sourceAccountId], references: [id])
  reason              String
  reasonCategory      ReceivableReasonCategory @default(OTHER)
  description         String?
  originalAmount      Decimal                  @db.Decimal(18, 2)
  receivedAmount      Decimal                  @default(0) @db.Decimal(18, 2)
  remainingAmount     Decimal                  @db.Decimal(18, 2)
  dueAt               DateTime?
  status              ReceivableStatus
  collections         ReceivableCollection[]
  ledgerEntries       LedgerEntry[]
  createdById         String
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([customerId])
  @@index([status, dueAt])
}

model ReceivableCollection {
  id                   String             @id @default(uuid())
  receivableId         String
  receivable           CustomerReceivable @relation(fields: [receivableId], references: [id])
  transactionId        String             @unique
  transaction          Transaction        @relation("ReceivableCollectionTransaction", fields: [transactionId], references: [id])
  collectionDate       DateTime
  destinationAccountId String
  destinationAccount   FinancialAccount   @relation("ReceivableCollectionAccount", fields: [destinationAccountId], references: [id])
  amount               Decimal            @db.Decimal(18, 2)
  referenceNumber      String?
  notes                String?
  status               PaymentStatus
  createdById          String
  createdAt            DateTime           @default(now())

  @@index([receivableId])
  @@index([destinationAccountId])
}

model ProviderSettlement {
  id                   String                      @id @default(uuid())
  sourceTransactionId  String                      @unique
  sourceTransaction    Transaction                 @relation("ProviderSettlementSourceTransaction", fields: [sourceTransactionId], references: [id])
  providerId           String?
  provider             Provider?                   @relation(fields: [providerId], references: [id])
  gatewayId            String?
  gateway              ProviderGateway?            @relation(fields: [gatewayId], references: [id])
  expectedAmount       Decimal                     @db.Decimal(18, 2)
  receivedAmount       Decimal                     @default(0) @db.Decimal(18, 2)
  remainingAmount      Decimal                     @db.Decimal(18, 2)
  destinationAccountId String
  destinationAccount   FinancialAccount            @relation("ProviderSettlementDestination", fields: [destinationAccountId], references: [id])
  dueAt                DateTime?
  status               ProviderSettlementStatus
  createdById          String
  receipts             ProviderSettlementReceipt[]
  ledgerEntries        LedgerEntry[]
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@index([providerId, gatewayId])
  @@index([status, dueAt])
  @@index([destinationAccountId])
}

model ProviderSettlementReceipt {
  id                   String             @id @default(uuid())
  settlementId         String
  settlement           ProviderSettlement @relation(fields: [settlementId], references: [id])
  transactionId        String             @unique
  transaction          Transaction        @relation("ProviderSettlementReceiptTransaction", fields: [transactionId], references: [id])
  receivedAt           DateTime
  destinationAccountId String
  destinationAccount   FinancialAccount   @relation("ProviderSettlementReceiptAccount", fields: [destinationAccountId], references: [id])
  amount               Decimal            @db.Decimal(18, 2)
  referenceNumber      String?
  notes                String?
  status               PaymentStatus
  createdById          String
  createdAt            DateTime           @default(now())

  @@index([settlementId])
  @@index([destinationAccountId])
}

model CashTransferDetail {
  id                    String               @id @default(uuid())
  transactionId         String               @unique
  transaction           Transaction          @relation(fields: [transactionId], references: [id])
  beneficiaryId         String?
  beneficiary           Beneficiary?         @relation(fields: [beneficiaryId], references: [id])
  beneficiaryAccountId  String?
  beneficiaryAccount    BeneficiaryAccount?  @relation(fields: [beneficiaryAccountId], references: [id])
  customerBankAccountId String?
  customerBankAccount   CustomerBankAccount? @relation(fields: [customerBankAccountId], references: [id])
  customerUpiAccountId  String?
  customerUpiAccount    CustomerUpiAccount?  @relation(fields: [customerUpiAccountId], references: [id])
  requestedAmount       Decimal              @db.Decimal(18, 2)
  commissionMethod      CommissionMethod
  commissionRate        Decimal              @db.Decimal(10, 4)
  commissionAmount      Decimal              @db.Decimal(18, 2)
  cashReceived          Decimal              @db.Decimal(18, 2)
  actualTransferAmount  Decimal              @db.Decimal(18, 2)
  transferChargeAmount  Decimal              @default(0) @db.Decimal(18, 2)
  transferChargeType    String?
  sourceAccountId       String
  sourceAccount         FinancialAccount     @relation("CashTransferSource", fields: [sourceAccountId], references: [id])
  cashAccountId         String
  cashAccount           FinancialAccount     @relation("CashTransferCash", fields: [cashAccountId], references: [id])
  transferReference     String?
  createdAt             DateTime             @default(now())
}

model QuickCashTransferDetail {
  id                      String            @id @default(uuid())
  transactionId           String            @unique
  transaction             Transaction       @relation(fields: [transactionId], references: [id])
  direction               String
  purpose                 String            @default("TRANSFER")
  serviceName             String?
  cashAccountId           String
  cashAccount             FinancialAccount  @relation("QuickCashMovementCash", fields: [cashAccountId], references: [id])
  sourceAccountId         String?
  sourceAccount           FinancialAccount? @relation("QuickCashMovementSource", fields: [sourceAccountId], references: [id])
  customerName            String?
  mobileNumber            String?
  amount                  Decimal           @db.Decimal(18, 2)
  commissionAmount        Decimal           @default(0) @db.Decimal(18, 2)
  commissionMode          String            @default("CASH")
  commissionAccountId     String?
  commissionAccount       FinancialAccount? @relation("QuickCashCommissionAccount", fields: [commissionAccountId], references: [id])
  completionTransactionId String?           @unique
  completedAt             DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([cashAccountId, direction])
  @@index([sourceAccountId])
  @@index([commissionAccountId])
}

model AepsDetail {
  id                   String            @id @default(uuid())
  transactionId        String            @unique
  transaction          Transaction       @relation(fields: [transactionId], references: [id])
  aadhaarLastFour      String
  customerBankName     String
  withdrawalAmount     Decimal           @db.Decimal(18, 2)
  platformId           String?
  providerId           String?
  gatewayId            String?
  platformChargeRate   Decimal?          @db.Decimal(10, 4)
  platformChargeAmount Decimal           @db.Decimal(18, 2)
  commissionRate       Decimal?          @db.Decimal(10, 4)
  commissionMethod     CommissionMethod  @default(DEDUCT)
  commissionAmount     Decimal           @db.Decimal(18, 2)
  cashGiven            Decimal           @db.Decimal(18, 2)
  cashAccountId        String?
  cashAccount          FinancialAccount? @relation("AepsCash", fields: [cashAccountId], references: [id])
  settlementAccountId  String
  settlementAccount    FinancialAccount  @relation("AepsSettlement", fields: [settlementAccountId], references: [id])
  settlementAmount     Decimal           @db.Decimal(18, 2)
  providerReference    String?
  createdAt            DateTime          @default(now())
}

model MicroAtmDetail {
  id                       String           @id @default(uuid())
  transactionId            String           @unique
  transaction              Transaction      @relation(fields: [transactionId], references: [id])
  cardLastFour             String
  customerBankName         String?
  withdrawalAmount         Decimal          @db.Decimal(18, 2)
  providerId               String
  gatewayId                String?
  providerCommissionRate   Decimal          @db.Decimal(10, 4)
  providerCommissionAmount Decimal          @db.Decimal(18, 2)
  cashGiven                Decimal          @db.Decimal(18, 2)
  cashAccountId            String
  cashAccount              FinancialAccount @relation("MicroAtmCash", fields: [cashAccountId], references: [id])
  settlementAccountId      String
  settlementAccount        FinancialAccount @relation("MicroAtmSettlement", fields: [settlementAccountId], references: [id])
  settlementAmount         Decimal          @db.Decimal(18, 2)
  providerReference        String?
  createdAt                DateTime         @default(now())
}

model InternalTransferDetail {
  id                   String           @id @default(uuid())
  transactionId        String           @unique
  transaction          Transaction      @relation(fields: [transactionId], references: [id])
  sourceAccountId      String
  sourceAccount        FinancialAccount @relation("InternalTransferSource", fields: [sourceAccountId], references: [id])
  destinationAccountId String
  destinationAccount   FinancialAccount @relation("InternalTransferDestination", fields: [destinationAccountId], references: [id])
  transferAmount       Decimal          @db.Decimal(18, 2)
  chargeAmount         Decimal          @default(0) @db.Decimal(18, 2)
  referenceNumber      String?
  createdAt            DateTime         @default(now())
}

model ExpenseDetail {
  id                String           @id @default(uuid())
  transactionId     String           @unique
  transaction       Transaction      @relation(fields: [transactionId], references: [id])
  expenseCategoryId String
  expenseCategory   ExpenseCategory  @relation(fields: [expenseCategoryId], references: [id])
  expenseType       UsageType
  paymentAccountId  String
  paymentAccount    FinancialAccount @relation(fields: [paymentAccountId], references: [id])
  amount            Decimal          @db.Decimal(18, 2)
  description       String
  createdAt         DateTime         @default(now())
}

model AtmWithdrawalDetail {
  id               String           @id @default(uuid())
  transactionId    String           @unique
  transaction      Transaction      @relation(fields: [transactionId], references: [id])
  bankAccountId    String
  bankAccount      FinancialAccount @relation("AtmBankAccount", fields: [bankAccountId], references: [id])
  cashAccountId    String
  cashAccount      FinancialAccount @relation("AtmCashAccount", fields: [cashAccountId], references: [id])
  withdrawalAmount Decimal          @db.Decimal(18, 2)
  cashReceived     Decimal          @db.Decimal(18, 2)
  atmCharge        Decimal          @db.Decimal(18, 2)
  referenceNumber  String?
  createdAt        DateTime         @default(now())
}

model CreditCardPaymentDetail {
  id                  String           @id @default(uuid())
  transactionId       String           @unique
  transaction         Transaction      @relation(fields: [transactionId], references: [id])
  creditCardAccountId String
  creditCardAccount   FinancialAccount @relation("CreditCardPaymentCard", fields: [creditCardAccountId], references: [id])
  sourceAccountId     String
  sourceAccount       FinancialAccount @relation("CreditCardPaymentSource", fields: [sourceAccountId], references: [id])
  paymentAmount       Decimal          @db.Decimal(18, 2)
  referenceNumber     String?
  createdAt           DateTime         @default(now())
}

model CashSession {
  id                      String                  @id @default(uuid())
  cashAccountId           String
  cashAccount             FinancialAccount        @relation(fields: [cashAccountId], references: [id])
  businessDate            DateTime                @db.Date
  openedById              String
  openedAt                DateTime
  openingTotal            Decimal                 @db.Decimal(18, 2)
  expectedClosingTotal    Decimal?                @db.Decimal(18, 2)
  actualClosingTotal      Decimal?                @db.Decimal(18, 2)
  differenceAmount        Decimal?                @db.Decimal(18, 2)
  closedById              String?
  closedAt                DateTime?
  closingNotes            String?
  adjustmentTransactionId String?                 @unique
  adjustmentTransaction   Transaction?            @relation("CashSessionAdjustment", fields: [adjustmentTransactionId], references: [id])
  status                  CashSessionStatus
  denominationCounts      CashDenominationCount[]

  @@index([cashAccountId, businessDate])
}

model CashDenominationCount {
  id            String      @id @default(uuid())
  cashSessionId String
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id])
  countType     CountType
  denomination  Decimal     @db.Decimal(10, 2)
  quantity      Int
  totalAmount   Decimal     @db.Decimal(18, 2)
  createdAt     DateTime    @default(now())

  @@index([cashSessionId, countType])
}

model LedgerAccount {
  id                 String            @id @default(uuid())
  ledgerCode         String            @unique
  ledgerName         String
  ledgerType         LedgerType
  ledgerCategory     String
  financialAccountId String?           @unique
  financialAccount   FinancialAccount? @relation(fields: [financialAccountId], references: [id])
  isActive           Boolean           @default(true)
  entries            LedgerEntry[]
  createdAt          DateTime          @default(now())
}

model LedgerJournal {
  id            String        @id @default(uuid())
  transactionId String        @unique
  transaction   Transaction   @relation(fields: [transactionId], references: [id])
  journalNumber String        @unique
  postingDate   DateTime
  description   String
  status        JournalStatus
  createdById   String
  entries       LedgerEntry[]
  createdAt     DateTime      @default(now())

  @@index([postingDate])
}

model LedgerEntry {
  id                   String              @id @default(uuid())
  journalId            String
  journal              LedgerJournal       @relation(fields: [journalId], references: [id])
  ledgerAccountId      String
  ledgerAccount        LedgerAccount       @relation(fields: [ledgerAccountId], references: [id])
  entryType            EntryType
  amount               Decimal             @db.Decimal(18, 2)
  customerId           String?
  customer             Customer?           @relation(fields: [customerId], references: [id])
  payableId            String?
  payable              CustomerPayable?    @relation(fields: [payableId], references: [id])
  receivableId         String?
  receivable           CustomerReceivable? @relation(fields: [receivableId], references: [id])
  providerSettlementId String?
  providerSettlement   ProviderSettlement? @relation(fields: [providerSettlementId], references: [id])
  description          String?
  createdAt            DateTime            @default(now())

  @@index([ledgerAccountId])
  @@index([journalId])
  @@index([providerSettlementId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  entityType String
  entityId   String
  action     String
  oldValues  Json?
  newValues  Json?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
}

model DailyAccountBalance {
  id                 String           @id @default(uuid())
  businessDate       DateTime         @db.Date
  financialAccountId String
  financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id])
  openingBalance     Decimal          @db.Decimal(18, 2)
  totalIn            Decimal          @db.Decimal(18, 2)
  totalOut           Decimal          @db.Decimal(18, 2)
  closingBalance     Decimal          @db.Decimal(18, 2)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([businessDate, financialAccountId])
}

